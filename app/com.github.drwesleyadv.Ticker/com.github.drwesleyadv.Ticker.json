{
  "$schema": "https://raw.githubusercontent.com/flatpak/flatpak-builder/main/data/flatpak-manifest.schema.json",
  "id": "com.github.drwesleyadv.Ticker",
  "runtime": "org.freedesktop.Platform",
  "runtime-version": "25.08",

  "base": "com.system76.Cosmic.BaseApp",
  "base-version": "stable",

  "sdk": "org.freedesktop.Sdk",
  "sdk-extensions": [
    "org.freedesktop.Sdk.Extension.rust-stable"
  ],

  "command": "ticker",

  "finish-args": [
    "--share=ipc",
    "--socket=wayland",
    "--share=network"
  ],

  "build-options": {
    "append-path": "/usr/lib/sdk/rust-stable/bin",
    "env": {
      "CARGO_HOME": "/run/build/ticker/cargo",
      "CARGO_NET_OFFLINE": "true"
    }
  },

  "modules": [
    {
      "name": "ticker",
      "buildsystem": "simple",
      "build-commands": [
        "cargo --offline fetch --manifest-path Cargo.toml",
        "cargo --offline build --release --locked",
        "install -Dm755 target/release/ticker /app/bin/ticker",
        "install -Dm644 resources/com.github.drwesleyadv.Ticker.desktop /app/share/applications/com.github.drwesleyadv.Ticker.desktop",
        "install -Dm644 resources/com.github.drwesleyadv.Ticker.metainfo.xml /app/share/metainfo/com.github.drwesleyadv.Ticker.metainfo.xml",
        "install -Dm644 resources/com.github.drwesleyadv.Ticker.svg /app/share/icons/hicolor/scalable/apps/com.github.drwesleyadv.Ticker.svg"
      ],
      "sources": [
        {
          "type": "git",
          "url": "https://github.com/drwesleyadv/Ticker.git",
          "commit": "d69d73c3fe877e2a9d1a322400629ccee7cef101"
        },
        "cargo-sources.json"
      ]
    }
  ]
}
